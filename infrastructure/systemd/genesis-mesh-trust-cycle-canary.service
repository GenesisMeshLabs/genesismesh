[Unit]
Description=Genesis Mesh daily trust-cycle verification canary
After=network-online.target genesis-mesh-na.service genesis-mesh-canary-001-na.service genesis-mesh-canary-anonymous-na.service
Wants=network-online.target
Requires=genesis-mesh-na.service genesis-mesh-canary-001-na.service genesis-mesh-canary-anonymous-na.service

[Service]
Type=oneshot
User=azureuser
WorkingDirectory=/opt/genesis-mesh
ExecStart=/opt/genesis-mesh/.venv/bin/genesis-mesh proof canary --acceptor http://127.0.0.1:19443 --issuer http://127.0.0.1:19444 --acceptor-operator-key /var/lib/genesis-mesh/trust-cycle-canary/001-na/keys/operator.key --acceptor-operator-key-id operator-local --issuer-operator-key /var/lib/genesis-mesh/trust-cycle-canary/anonymous-na/keys/operator.key --issuer-operator-key-id operator-local --receipt-signing-key /var/lib/genesis-mesh/trust-cycle-canary/001-na/keys/na.key --receipt-signing-key-id na-local --receipt /var/lib/genesis-mesh/trust-cycle-canary/latest.signed.json --audit-db /var/lib/genesis-mesh/na.db
TimeoutStartSec=120

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/genesis-mesh
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
