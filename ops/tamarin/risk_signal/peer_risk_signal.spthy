/*
 * GenesisMesh PeerRiskSignal — Tamarin Prover Model (revised v0.61.1)
 *
 * Models genesis_mesh/trust/risk_signal.py:update_risk_signal.
 *
 * What the implementation does, and this model keeps:
 *   - Each sovereign S keeps its own signal for a counterparty C, created at
 *     0.5 (create_risk_signal). Nothing is shared between sovereigns.
 *   - Each update consumes one ExecutionEvidence outcome for C. The network
 *     adversary chooses every outcome and evidence id (the model gives the
 *     adversary full control; it does not assume evidence is honest).
 *   - The new value is clamped to [0, 1] (_clamp).
 *   - Anomaly detection runs inside the same update, and only when the
 *     signal has at least _ANOMALY_MIN_HISTORY (10) prior updates and the
 *     update's delta is a statistical outlier (|delta - mu| > 3 sigma), in
 *     either direction.
 *
 * Abstractions:
 *   - Signal values are the lattice {low, mid, high}; the posterior is any
 *     lattice value (the EWMA arithmetic is not modelled).
 *   - "At least 10 prior updates" is the history state 'warm'; a signal
 *     becomes warm only after an update ('cold' -> 'warm' happens in an
 *     update step), which records !History(S, C, sid): the update history
 *     that update_risk_signal takes as input. The count of 10 itself is not
 *     modelled.
 *   - Whether a delta is an outlier depends on statistics of past deltas, so
 *     the model lets every update be either 'normal' or 'outlier'.
 *
 * Revision note: the v0.48 model left `S` and `C` unbound in InitSignal (two
 * wellformedness failures) and claimed that every sudden drop is followed by
 * an anomaly. That claim is false for the implementation itself: a drop with
 * fewer than 10 prior updates, or with no variance in past deltas, raises no
 * anomaly. The lemmas below state what the implementation does guarantee.
 */

theory PeerRiskSignal
begin

/* Lattice of signal values: the only values a signal can take. */
rule Lattice_low:  [ ] --[ OnlyOnce('low') ]->  [ !Lattice('low') ]
rule Lattice_mid:  [ ] --[ OnlyOnce('mid') ]->  [ !Lattice('mid') ]
rule Lattice_high: [ ] --[ OnlyOnce('high') ]-> [ !Lattice('high') ]

restriction only_once:
  "All x #i #j. OnlyOnce(x) @ #i & OnlyOnce(x) @ #j ==> #i = #j"

/* create_risk_signal: sovereign $S starts a signal ~sid for $C at 0.5. */
rule InitSignal:
    [ Fr(~sid) ]
  --[ Init($S, $C, ~sid), Signal($S, $C, ~sid, 'mid') ]->
    [ Sig($S, $C, ~sid, 'mid', 'cold') ]

/* An update whose delta is not an outlier. History may become warm. */
rule UpdateSignal_Normal:
    [ Sig(S, C, sid, v, h), In(<'evidence', C, e, outcome>), !Lattice(v2) ]
  --[ Received(S, C, sid, e), Update(S, C, sid, v, v2), Signal(S, C, sid, v2) ]->
    [ Sig(S, C, sid, v2, h) ]

rule UpdateSignal_Normal_Warms:
    [ Sig(S, C, sid, v, 'cold'), In(<'evidence', C, e, outcome>), !Lattice(v2) ]
  --[ Received(S, C, sid, e), Update(S, C, sid, v, v2), Signal(S, C, sid, v2), Warmed(S, C, sid) ]->
    [ Sig(S, C, sid, v2, 'warm'), !History(S, C, sid) ]

/* An outlier delta with too little history: the implementation raises nothing. */
rule UpdateSignal_Outlier_Cold:
    [ Sig(S, C, sid, v, 'cold'), In(<'evidence', C, e, outcome>), !Lattice(v2) ]
  --[ Received(S, C, sid, e), Update(S, C, sid, v, v2), Signal(S, C, sid, v2),
      Outlier(S, C, sid, e, 'cold') ]->
    [ Sig(S, C, sid, v2, 'cold') ]

/* An outlier delta with enough history: the anomaly is raised in the same update. */
rule UpdateSignal_Outlier_Warm:
    [ Sig(S, C, sid, v, 'warm'), !History(S, C, sid), In(<'evidence', C, e, outcome>), !Lattice(v2) ]
  --[ Received(S, C, sid, e), Update(S, C, sid, v, v2), Signal(S, C, sid, v2),
      Outlier(S, C, sid, e, 'warm'), AnomalyDetected(S, C, sid, e) ]->
    [ Sig(S, C, sid, v2, 'warm'), Out(<'anomaly', S, C, e>) ]


/* Lemma 1: a signal only ever holds a lattice value (the clamp to [0, 1]). */
lemma signal_bounded:
  "All S C sid v #t. Signal(S, C, sid, v) @ #t ==> (v = 'low' | v = 'mid' | v = 'high')"

/*
 * Lemma 2: an anomaly is raised only by the owner's own update, on evidence
 * that the owner itself processed, whose delta was an outlier.
 */
lemma anomaly_requires_local_outlier:
  "All S C sid e #t. AnomalyDetected(S, C, sid, e) @ #t ==>
     Received(S, C, sid, e) @ #t & Outlier(S, C, sid, e, 'warm') @ #t"

/* Lemma 3: an anomaly requires a signal with enough history (it warmed earlier). */
lemma anomaly_requires_history:
  "All S C sid e #t. AnomalyDetected(S, C, sid, e) @ #t ==>
     (Ex #w. Warmed(S, C, sid) @ #w & #w < #t)"

/*
 * Lemma 4: detection cannot be suppressed or deferred. With enough history,
 * the update that processes an outlier raises the anomaly in the same step.
 */
lemma detection_is_synchronous:
  "All S C sid e #t. Outlier(S, C, sid, e, 'warm') @ #t ==> AnomalyDetected(S, C, sid, e) @ #t"

/*
 * Lemma 5: no cascade from a single observation. Anomalies about the same
 * counterparty at two different sovereigns each come from evidence that
 * sovereign processed itself, in its own update.
 */
lemma no_single_source_cascade:
  "All C S1 S2 sid1 sid2 e1 e2 #t1 #t2.
     AnomalyDetected(S1, C, sid1, e1) @ #t1 & AnomalyDetected(S2, C, sid2, e2) @ #t2 & not(S1 = S2) ==>
     Received(S1, C, sid1, e1) @ #t1 & Received(S2, C, sid2, e2) @ #t2"

/* Sanity: anomalies are reachable, at two sovereigns about one counterparty (the lemmas are not vacuous). */
lemma anomaly_reachable:
  exists-trace
  "Ex C S1 S2 sid1 sid2 e1 e2 #t1 #t2.
     AnomalyDetected(S1, C, sid1, e1) @ #t1 & AnomalyDetected(S2, C, sid2, e2) @ #t2 & not(S1 = S2)"

/* Sanity: a cold outlier raises nothing, which is why "every drop is detected" is not claimed. */
lemma cold_outlier_reachable_without_anomaly:
  exists-trace
  "Ex S C sid e #t. Outlier(S, C, sid, e, 'cold') @ #t & not(Ex #a. AnomalyDetected(S, C, sid, e) @ #a)"

end
