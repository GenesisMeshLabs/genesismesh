# Shape only. Never commit real values.
POSTGRES_PASSWORD=change-me
# Signed genesis block JSON (single line), as produced by `genesis-mesh init`.
GENESIS_JSON={"network_name":"...","signatures":[...]}
# The NA seed is not set here: it is the file secrets/na_seed (the base64
# line of the NA key named in the genesis block), readable by uid 10001.
NA_KEY_ID=na-ha
OPERATOR_PUBLIC_KEYS_JSON={"ops":"base64-operator-public-key"}
OPERATOR_KEY_TIERS_JSON={"ops":"privileged"}
