# Allowlist (v1.1): only what the image build needs enters the build context.
# Everything else stays out, including any key, .env file or database anywhere
# in the tree, local state directories, virtual environments and Git history.
*
!pyproject.toml
!setup.py
!README.md
!LICENSE
!start.sh
!requirements-image.lock
!requirements-build.lock
!docker/healthcheck.sh
!genesis_mesh/

# Not needed for the wheel, and never secrets inside the allowed tree.
genesis_mesh/tests/
**/__pycache__/
**/*.py[cod]
**/*.key
**/*.pem
**/*.seed
**/.env
**/.env.*
**/*.db
**/*.db-*
**/*.sqlite*
